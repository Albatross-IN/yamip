<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_custom" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='right-elements']" position="before">
            <div id="left-elements" t-attf-class="#{'col-6 mt-5' if report_type == 'pdf' else 'col-12 col-md-6'} d-inline-block float-start" style="page-break-inside: avoid;">
                <div class="row w-100">
                    <!-- <div class="col-7 pt-2">
                        <strong>Account Details</strong><br/>
                        RNDGRID PRIVATE LIMITED<br/>
                        A/c: 10105736550<br/>
                        Bank: IDFC First Bank<br/>
                        IFSC: IDFB0040315
                    </div> -->
                    <div class="col-5 text-center" t-if="o.qr_code_image">
                        <strong>Scan to Pay via UPI</strong><br/>
                        <img t-att-src="image_data_uri(o.qr_code_image)" style="width: 28mm; height: 28mm; margin-top: 5px;"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_invoice_page_upi_qr" inherit_id="account.portal_invoice_page">
        <xpath expr="//div[hasclass('o_download_pdf')]" position="after">
            <t t-if="invoice.company_id.account_fiscal_country_id.code == 'IN' and invoice.qr_code_image and invoice.payment_state in ('not_paid', 'partial')">
                <div class="d-flex flex-column gap-2 mt-4 text-center">
                    <h6 class="mb-0">Pay with UPI</h6>
                    <div class="d-flex justify-content-center">
                        <img t-att-src="image_data_uri(invoice.qr_code_image)" style="width: 150px; height: 150px;" alt="UPI QR Code"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>