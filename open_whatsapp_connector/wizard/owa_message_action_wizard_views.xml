<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Forward wizard -->
  <record id="view_owa_message_forward_wizard_form" model="ir.ui.view">
    <field name="name">owa.message.forward.wizard.form</field>
    <field name="model">owa.message.forward.wizard</field>
    <field name="arch" type="xml">
      <form string="Forward WhatsApp Message">
        <sheet>
          <group>
            <field name="owa_message_id" readonly="1"/>
            <field name="wa_account_id" readonly="1"/>
          </group>
          <group string="Targets (pick at least one)">
            <field name="target_channel_ids" widget="many2many_tags"
                   options="{'no_create': True}" colspan="2" nolabel="1"/>
            <field name="target_phones" colspan="2" nolabel="1"
                   placeholder="One number per line, e.g. 919999999999"/>
          </group>
        </sheet>
        <footer>
          <button name="action_forward" type="object" string="Forward"
                  class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_owa_message_forward_wizard" model="ir.actions.act_window">
    <field name="name">Forward WhatsApp Message</field>
    <field name="res_model">owa.message.forward.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <!-- binding_model_id removed: owa.message has limited UI presence so the
         cog menu was effectively invisible. Reached now via the Forward
         header button on the owa.message form view. -->
  </record>

  <!-- React wizard -->
  <record id="view_owa_message_react_wizard_form" model="ir.ui.view">
    <field name="name">owa.message.react.wizard.form</field>
    <field name="model">owa.message.react.wizard</field>
    <field name="arch" type="xml">
      <form string="React to WhatsApp Message">
        <sheet>
          <group>
            <field name="owa_message_id" readonly="1"/>
            <field name="wa_account_id" readonly="1"/>
            <field name="emoji"/>
          </group>
        </sheet>
        <footer>
          <button name="action_react" type="object" string="Send Reaction"
                  class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_owa_message_react_wizard" model="ir.actions.act_window">
    <field name="name">React to WhatsApp Message</field>
    <field name="res_model">owa.message.react.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <!-- binding removed: see action_owa_message_forward_wizard. -->
  </record>

  <!-- Edit wizard -->
  <record id="view_owa_message_edit_wizard_form" model="ir.ui.view">
    <field name="name">owa.message.edit.wizard.form</field>
    <field name="model">owa.message.edit.wizard</field>
    <field name="arch" type="xml">
      <form string="Edit WhatsApp Message">
        <sheet>
          <group>
            <field name="owa_message_id" readonly="1"/>
            <field name="wa_account_id" readonly="1"/>
          </group>
          <group>
            <field name="new_body" colspan="2" nolabel="1"
                   placeholder="Edited message text"/>
          </group>
        </sheet>
        <footer>
          <button name="action_edit" type="object" string="Save Edit"
                  class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_owa_message_edit_wizard" model="ir.actions.act_window">
    <field name="name">Edit WhatsApp Message</field>
    <field name="res_model">owa.message.edit.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
