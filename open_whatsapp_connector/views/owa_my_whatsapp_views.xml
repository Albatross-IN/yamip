<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Self-service entry point for internal users. Visible to all internal
         users, but the owa.account record rule + manage ACL mean a user only
         sees/creates their own (a Sales-Team leader also sees their team).
         The admin Accounts screen stays admin-only. v1 reuses the admin form
         (owa_account_view_form); its admin-only buttons are group-hidden and
         the pending-approval banner shows for a salesperson. -->
    <record id="owa_my_whatsapp_view_list" model="ir.ui.view">
        <field name="name">owa.account.my.list</field>
        <field name="model">owa.account</field>
        <field name="arch" type="xml">
            <list string="My WhatsApp">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="session_state" widget="badge"
                       decoration-success="session_state == 'connected'"
                       decoration-danger="session_state in ('disconnected','logged_out')"/>
                <field name="approval_state" widget="badge"
                       decoration-success="approval_state == 'approved'"
                       decoration-warning="approval_state == 'pending'"
                       decoration-danger="approval_state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="action_owa_my_whatsapp" model="ir.actions.act_window">
        <field name="name">My WhatsApp</field>
        <field name="res_model">owa.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('user_id', '=', uid), ('team_id.user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('owa_my_whatsapp_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('owa_account_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your WhatsApp</p>
            <p>Create an account, scan the QR with your phone, then wait for an
               administrator to approve it before it can send or receive.</p>
        </field>
    </record>

    <menuitem id="menu_owa_my_whatsapp" name="My WhatsApp"
              parent="open_whatsapp_connector.menu_owa_root"
              action="action_owa_my_whatsapp" sequence="7"/>
</odoo>